# ─────────────────────────────────────────────────────────────
# Enterprise RAG — configuração (todas as variáveis usam RAG_)
# Copie para .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false

# ── Vector store ────────────────────────────────────────────
# qdrant  -> produção / docker compose
# memory  -> zero dependência, roda em CI e em laptop sem docker
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=enterprise_rag
# RAG_QDRANT_API_KEY=

# ── Embeddings ──────────────────────────────────────────────
# sentence-transformers -> qualidade real
# hashing               -> determinístico, sem download, usado nos testes
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_DENSE_MODEL=intfloat/multilingual-e5-small
RAG_DENSE_DIM=384
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# ── Chunking ────────────────────────────────────────────────
# fixed | structural
RAG_CHUNK_STRATEGY=structural
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=60

# ── Retrieval ───────────────────────────────────────────────
RAG_TOP_K_CANDIDATES=30
RAG_TOP_K_FINAL=6
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0
RAG_USE_HYBRID=true

# ── Reranking ───────────────────────────────────────────────
# cross-encoder | lexical | none
RAG_RERANKER_BACKEND=cross-encoder
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_MIN_SCORE=-6.0

# ── Context builder ─────────────────────────────────────────
RAG_MAX_CONTEXT_TOKENS=7000
RAG_MAX_CHUNKS_PER_DOCUMENT=3
RAG_DEDUP_SIMILARITY=0.92

# ── Geração ─────────────────────────────────────────────────
# ollama | echo (echo = extrativo determinístico, para CI)
RAG_LLM_BACKEND=ollama
RAG_OLLAMA_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:7b-instruct
RAG_OLLAMA_TEMPERATURE=0.1
RAG_OLLAMA_NUM_CTX=8192
RAG_OLLAMA_TIMEOUT=120

# ── Persistência de metadados ───────────────────────────────
RAG_DATA_DIR=./data
RAG_CATALOG_PATH=./data/catalog.sqlite3

# ── OpenTelemetry (opcional) ────────────────────────────────
RAG_OTEL_ENABLED=false
# RAG_OTEL_ENDPOINT=http://localhost:4318/v1/traces
